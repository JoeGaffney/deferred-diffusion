FROM python:3.12.10-alpine3.21

WORKDIR /app

# Copy requirements first for better caching
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only specific directories instead of everything
COPY api_v2/ ./api_v2/
COPY shared/ ./shared/
COPY local_worker/tasks/ ./local_worker/tasks/
COPY external_worker/tasks/ ./external_worker/tasks/

# Copy LICENSE and README files
COPY README.md /README.md
COPY LICENSE /LICENSE
LABEL license="MIT"

# Set the working directory to the app folder
WORKDIR /app

# Expose the port FastAPI runs on
EXPOSE 5000

# Command to run the application from app directory, referencing api_v2 package
CMD ["uvicorn", "api_v2.main:app", "--host", "0.0.0.0", "--port", "5000", "--workers", "4", "--timeout-keep-alive", "60"]
